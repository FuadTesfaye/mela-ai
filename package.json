{
  "name": "mela-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run widget:build && next dev --webpack --hostname 0.0.0.0",
    "build": "npm run widget:build && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "widget:build": "node scripts/build-widget.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx tests/unit/index.ts",
    "test:integration": "node --import tsx tests/integration/api.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "worker:telegram": "node --env-file-if-exists=.env --import tsx workers/telegram.ts",
    "worker:alerts": "node --env-file-if-exists=.env --import tsx workers/alerts.ts",
    "test:db": "node --import tsx tests/integration/postgres.test.ts",
    "test:widget": "npm run widget:build && node --import tsx tests/widget.mjs",
    "format": "prettier --write app components lib module workers scripts tests *.ts *.json *.yml *.md",
    "prepare:video": "python3 scripts/prepare-video.py"
  },
  "dependencies": {
    "lucide-react": "0.475.0",
    "next": "16.4.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.7.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.187.0",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "linkedom": "^0.18.14",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.31"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
