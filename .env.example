DATABASE_URL=postgresql://mela:mela@localhost:5432/mela
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173
ADMIN_PASSWORD=
SESSION_SECRET=
AI_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
CLOUD_AI_URL=
CLOUD_AI_KEY=
CLOUD_AI_MODEL=
TELEGRAM_BOT_TOKEN=
SMS_API_URL=
SMS_API_KEY=
SMS_INBOUND_SECRET=
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
POSTGRES_PASSWORD=mela-local-only
WEBHOOK_ALLOWED_HOSTS=
RETENTION_DAYS=30
STUN_URL=
TRUST_PROXY=false

# Native Google Gemini support; keep the real key in .env.local or your secret store.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional reviewed signing video, bound to the exact YouTube lesson video ID.
COURSE_VIDEO_URL=https://www.youtube.com/watch?v=9hE5-98ZeCg
SIGN_LANGUAGE_VIDEO_URL=
SIGN_LANGUAGE_VALIDATED=false
SIGN_LANGUAGE_REVIEWER=
SIGN_LANGUAGE_LESSON_VIDEO_ID=
SIGN_LANGUAGE_OFFSET_SECONDS=0

# Local signing media directory; Docker uses its persistent mela-signing volume.
SIGNING_STORAGE_DIR=./data-runtime/signing

# Browser-first questions do not need an AI key. Explicit new AI requests use
# the server relay: set AI_PROVIDER=gemini and GEMINI_API_KEY privately in Vercel.
# Never use NEXT_PUBLIC_GEMINI_API_KEY. Same-origin deployments infer their
# request origin; add external SDK host origins to ALLOWED_ORIGINS.

# Supabase: runtime uses the transaction pooler (:6543), migration uses session (:5432).
# Copy both endpoints from Connect; keep real passwords in private secret settings.
MIGRATION_DATABASE_URL=
DB_POOL_MAX=1
DEFAULT_COURSE_ID=va-foundations
OPS_SECRET=
TELEGRAM_WEBHOOK_SECRET=
SIGNING_STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SIGNING_BUCKET=mela-signing

# Optional Groq key: Whisper transcription and fallback answers when Gemini is unavailable.
GROQ_API_KEY=
GROQ_VOICE=diana

# Optional Addis AI key: Amharic/Afaan Oromo/Tigrinya voices, speech-to-text and answers (paid in ETB).
ADDIS_API_KEY=
